# Apex Dental Studio - Environment Configuration
# Copy this file to .env.local and populate with your Supabase credentials

# Supabase Public Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (safe for browser exposure under Row-Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# Secret key for server-side HMAC session cookie signing
AUTH_SECRET=your-random-32-character-auth-secret-here
